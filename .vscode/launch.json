{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CAMMP-SFSE: Interactive Mode (Recommended)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "CAMMP-SFSE: Process Sample Image",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--input", "data/sample/synthetic_sem.png",
                "--output", "outputs/"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "CAMMP-SFSE: Batch Process Real SEM Micrographs",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--input", "data/raw/",
                "--output", "outputs/",
                "--min-area", "30"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "CAMMP-SFSE: Generate Synthetic SEM Sample",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--generate-sample"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
